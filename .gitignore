# Agents-mailroom public source repository: ALLOW-LIST.
# Everything is ignored unless re-included below. Private store data (bus/, todo/, status/,
# archive/, exports/, review/, attachments/, .mailroom-data/) stays ignored here; private store
# snapshots use an isolated GIT_DIR with its own exclude rules via tools/snapshot.py.
/*
!/.gitignore
!/.size-allowlist
!/README.md
!/.githooks/
!/tools/

# --- mailroom app source (no builds, no node_modules, no local wrappers) ---
!/mailroom/
/mailroom/**
!/mailroom/**/
!/mailroom/run.sh
!/mailroom/bus/*.py
!/mailroom/web/src/**
!/mailroom/web/*.json
!/mailroom/web/*.ts
!/mailroom/web/*.mjs
!/mailroom/web/*.md
!/mailroom/web/.gitignore
!/mailroom/web/public/*.svg
/mailroom/**/node_modules/
/mailroom/**/.next/
/mailroom/**/out/
/mailroom/**/__pycache__/
/mailroom/web/tsconfig.tsbuildinfo
/mailroom/**/.*-build.*/
/mailroom/**/.tmp_*/
/mailroom/sandbox/

# --- never, anywhere ---
*.sqlite3
*.sqlite3-*
*.db
*.lock
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
*token*
*secret*
*.log

# Private runtime state for this checkout.
/.mailroom-data/

# Setup documentation and the starter goal seed.
!/docs/
/docs/**
!/docs/GOALS.md
!/docs/OPERATIONS.md
