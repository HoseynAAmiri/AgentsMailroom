# Coordination store: ALLOW-LIST. Everything is ignored unless re-included below.
# Local history only: this repository has no remote and is never pushed.
# Add paths with tools/snapshot.py only (explicit allow-list, never `git add -A`).
# Size/secret/raw-state limits are enforced by .githooks/pre-commit (install: tools/install_hooks.sh).
/*
!/.gitignore
!/.size-allowlist
!/README.md
!/.githooks/
!/tools/

# --- reviewed exports only (tools/snapshot.py): event metadata projection, task dump ---
!/exports/
/exports/**
!/exports/**/
!/exports/events/*.jsonl
!/exports/todo/tasks.safe.json
# bus/ (raw events, cursors, sessions, registry, USER state) is never tracked


# --- attachments: only paths listed in review/attachments.allow (snapshot.py adds them; hook checks) ---
!/attachments/
/attachments/**
!/attachments/**/
!/review/

# archive/ stays on disk and in the rollback checkpoint only (not tracked)

# --- mailroom app source (no builds, no node_modules) ---
!/mailroom/
/mailroom/**
!/mailroom/**/
!/mailroom/*.sh
!/mailroom/bus/*.py
!/mailroom/web/src/**
!/mailroom/web/*.json
!/mailroom/web/*.ts
!/mailroom/web/*.mjs
!/mailroom/web/*.md
!/mailroom/web/.gitignore
!/mailroom/web/public/*.svg
/mailroom/**/node_modules/
/mailroom/**/.next/
/mailroom/**/out/
/mailroom/**/__pycache__/
/mailroom/web/tsconfig.tsbuildinfo
/mailroom/**/.*-build.*/
/mailroom/**/.tmp_*/
/mailroom/sandbox/

# --- never, anywhere ---
*.sqlite3
*.sqlite3-*
*.db
*.lock
.env
.env.*
*.pem
*.key
id_rsa*
id_ed25519*
*token*
*secret*
*.log

# --- kept on disk only: repository snapshots and data files over 1 MiB ---
/attachments/**/clean_build/

# Private runtime state for this checkout.
/.mailroom-data/

# Setup documentation and the starter goal seed.
!/docs/
/docs/**
!/docs/GOALS.md
!/docs/OPERATIONS.md
